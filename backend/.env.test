# The suite creates the database named here on the server `poe db-up` starts,
# migrates it and drops it at the end. The other values are placeholders: no
# mail leaves the suite. See docs/testing.md §7 and §9.
DATABASE_URL=postgresql+asyncpg://usr:pswd@localhost:5432/test
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=warning
MAIL_FROM=test@localhost
MAIL_FROM_NAME=test
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=none
